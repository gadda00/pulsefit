# Force npm to use the legacy peer-dep resolution algorithm.
# Required because Expo SDK 51 ships react@18.2.0 but react-native-web@0.19.x
# pulls react-dom@18.3.x which expects react@^18.3.1 — a peer-dep conflict
# that the modern npm resolver rejects. Without this file, EAS Build's
# `npm install` step fails with ERESOLVE.
legacy-peer-deps=true
