{
  "name": "pulsefit",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "postinstall": "bash patches/apply-gradle-fixes.sh"
  },
  "jest": {
    "preset": "jest-expo",
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.js"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|@react-navigation/.*|@sentry/react-native|native-base|react-native-svg|react-native-reanimated|react-native-gesture-handler|react-native-screens|react-native-safe-area-context|react-native-redash|victory-native|@shopify/.*|react-native-chart-kit|react-native-progress|expo-router|expo-asset|expo-constants|expo-font|expo-linear-gradient|expo-linking|expo-status-bar|expo-system-ui|expo-web-browser)"
    ],
    "moduleNameMapper": {
      "^expo-modules-core/build/Refs$": "<rootDir>/__mocks__/RefsStub.js",
      "^expo-modules-core/build/uuid/uuid\\.web$": "<rootDir>/__mocks__/uuidWebStub.js",
      "^expo-modules-core/build/web/index\\.web$": "<rootDir>/__mocks__/webIndexStub.js",
      "^@/(.*)$": "<rootDir>/src/$1",
      "^@components/(.*)$": "<rootDir>/src/components/$1",
      "^@lib/(.*)$": "<rootDir>/src/lib/$1",
      "^@hooks/(.*)$": "<rootDir>/src/hooks/$1",
      "^@store/(.*)$": "<rootDir>/src/store/$1",
      "^@constants/(.*)$": "<rootDir>/src/constants/$1",
      "^@assets/(.*)$": "<rootDir>/assets/$1"
    },
    "collectCoverageFrom": [
      "src/**/*.{ts,tsx}",
      "!src/**/*.d.ts",
      "!src/**/index.ts"
    ]
  },
  "dependencies": {
    "@expo/vector-icons": "^14.0.2",
    "@react-native-async-storage/async-storage": "1.23.1",
    "@react-navigation/native": "^6.1.18",
    "@react-navigation/native-stack": "^6.11.0",
    "@shopify/flash-list": "1.7.3",
    "@unimodules/core": "^7.1.2",
    "ajv": "^8.20.0",
    "ajv-keywords": "^5.1.0",
    "expo": "~51.0.28",
    "expo-camera": "~15.0.16",
    "expo-constants": "~16.0.2",
    "expo-font": "~12.0.10",
    "expo-haptics": "~13.0.1",
    "expo-linear-gradient": "~13.0.2",
    "expo-linking": "~6.3.1",
    "expo-router": "~3.5.23",
    "expo-sqlite": "~14.0.6",
    "expo-status-bar": "~2.0.1",
    "expo-system-ui": "~3.0.7",
    "expo-updates": "^0.25.28",
    "expo-web-browser": "~13.0.3",
    "react": "18.2.0",
    "react-native": "0.74.5",
    "react-native-chart-kit": "^6.12.0",
    "react-native-gesture-handler": "~2.16.1",
    "react-native-paper": "^5.12.5",
    "react-native-reanimated": "~3.16.1",
    "react-native-safe-area-context": "4.10.5",
    "react-native-screens": "3.31.1",
    "react-native-svg": "15.2.0",
    "react-native-web": "~0.19.10",
    "safe-buffer": "^5.2.1",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react-native": "^12.8.1",
    "@types/jest": "^29.5.12",
    "@types/react": "~18.2.79",
    "@types/react-test-renderer": "^18.3.0",
    "babel-preset-expo": "^11.0.14",
    "eas-cli": "^22.6.0",
    "eslint": "^8.57.0",
    "eslint-config-expo": "^7.1.2",
    "expo-modules-core": "^57.0.13",
    "jest": "^29.7.0",
    "jest-expo": "~51.0.4",
    "react-test-renderer": "18.2.0",
    "typescript": "~5.3.3"
  },
  "private": true,
  "expo": {
    "autolinking": {
      "exclude": []
    }
  }
}
